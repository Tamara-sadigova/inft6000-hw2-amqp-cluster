C4Deployment
    title Deployment Diagram - Docker Network hw2-net

    Deployment_Node(host, "Host Machine", "Docker Engine / Compose") {
        Deployment_Node(net, "Docker Network: hw2-net", "Bridge Network") {

            Deployment_Node(n1, "rabbit1", "RabbitMQ 3.13") {
                Container(b1, "RabbitMQ Node 1", "Broker", "AMQP: 5672")
                ContainerDb(v1, "rabbit1-data", "Volume", "/var/lib/rabbitmq")
            }

            Deployment_Node(n2, "rabbit2", "RabbitMQ 3.13") {
                Container(b2, "RabbitMQ Node 2", "Broker", "AMQP: 5672")
                ContainerDb(v2, "rabbit2-data", "Volume", "/var/lib/rabbitmq")
            }

            Deployment_Node(n3, "rabbit3", "RabbitMQ 3.13") {
                Container(b3, "RabbitMQ Node 3", "Broker", "AMQP: 5672")
                ContainerDb(v3, "rabbit3-data", "Volume", "/var/lib/rabbitmq")
            }

            Deployment_Node(pr, "Prometheus", "prom/prometheus") {
                Container(p, "Prometheus", "Monitoring", "Port: 9090")
            }

            Deployment_Node(gr, "Grafana", "grafana/grafana") {
                Container(g, "Grafana", "Dashboard", "Port: 3000")
            }
        }
    }

    Rel(b1, b2, "Erlang distribution")
    Rel(b2, b3, "Erlang distribution")
    Rel(b1, b3, "Erlang distribution")

    Rel(p, b1, "Scrape metrics")
    Rel(p, b2, "Scrape metrics")
    Rel(p, b3, "Scrape metrics")

    Rel(g, p, "Query")
